{
  "name": "@shieldlabs-ai/mcp",
  "version": "1.0.0",
  "description": "ShieldLabs MCP server: read identifications, search history, summarize users, devices and IPs, explain Risk Scores and verify webhook signatures from any MCP client.",
  "license": "MIT",
  "author": "ShieldLabs Inc. <contact@shieldlabs.ai>",
  "homepage": "https://docs.shieldlabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldLabs-ai/shieldlabs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ShieldLabs-ai/shieldlabs-mcp/issues",
    "email": "contact@shieldlabs.ai"
  },
  "keywords": [
    "shieldlabs",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "device-intelligence",
    "risk-score",
    "fraud-prevention"
  ],
  "mcpName": "io.github.shieldlabs-ai/shieldlabs-mcp",
  "type": "module",
  "bin": {
    "shieldlabs-mcp": "dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "HOSTED-OPERATIONS.md",
    "INSTALLER-GATEWAY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/worker",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "mock-api": "node scripts/mock-history-api.mjs",
    "smoke": "node scripts/smoke-stdio.mjs",
    "worker:check": "node scripts/check-worker-bundle.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  }
}
